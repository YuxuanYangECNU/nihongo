  "grammar": [
    {
      "id": "noun",
      "group": "四大基本句型",
      "title": "名词句",
      "subtitle": "用「です／だ」说明是什么",
      "formula": "名词 ＋ です／だ",
      "description": "名词作谓语时，用です或だ表达身份、性质等。先把礼貌程度与时间分开理解。",
      "points": [
        "敬体与简体主要区别在表达方式，不是两个不同意思。",
        "日语的“现在形”也可表示未来，因此这里统一标为“非过去”。",
        "じゃない＝ではない的口语形式。"
      ],
      "examples": [
        {
          "text": "私は学生です。",
          "kana": "わたしはがくせいです。",
          "meaning": "我是学生。",
          "focus": "です",
          "source": "笔记例句"
        },
        {
          "text": "私は学生ではありませんでした。",
          "kana": "わたしはがくせいではありませんでした。",
          "meaning": "我以前不是学生。",
          "focus": "ではありませんでした",
          "source": "笔记例句"
        }
      ],
      "forms": [
        {
          "label": "敬体 · 非过去肯定",
          "text": "学生です"
        },
        {
          "label": "敬体 · 非过去否定",
          "text": "学生ではありません"
        },
        {
          "label": "敬体 · 过去肯定",
          "text": "学生でした"
        },
        {
          "label": "敬体 · 过去否定",
          "text": "学生ではありませんでした"
        },
        {
          "label": "简体 · 非过去肯定",
          "text": "学生だ"
        },
        {
          "label": "简体 · 非过去否定",
          "text": "学生ではない"
        },
        {
          "label": "简体 · 过去肯定",
          "text": "学生だった"
        },
        {
          "label": "简体 · 过去否定",
          "text": "学生ではなかった"
        }
      ],
      "addedAt": "2026-11-12",
      "level": "基础"
    },
    {
      "id": "i-adj",
      "group": "四大基本句型",
      "title": "い形容词句",
      "subtitle": "寒い → 寒くない → 寒かった",
      "formula": "い → くない／かった／くなかった",
      "description": "い形容词本身可以变化。简体肯定直接使用词尾い，不加だ。",
      "points": [
        "寒いです是敬体，寒い是简体；不能说寒いだ。",
        "否定：去い＋くない；过去：去い＋かった。",
        "いい是常见例外：よくない、よかった、よくなかった。"
      ],
      "examples": [
        {
          "text": "今日は寒いです。",
          "kana": "きょうはさむいです。",
          "meaning": "今天很冷。",
          "focus": "寒い",
          "source": "笔记例句"
        },
        {
          "text": "昨日は寒くなかったです。",
          "kana": "きのうはさむくなかったです。",
          "meaning": "昨天不冷。",
          "focus": "寒くなかった",
          "source": "笔记例句"
        }
      ],
      "forms": [
        {
          "label": "敬体 · 非过去肯定",
          "text": "寒いです"
        },
        {
          "label": "敬体 · 非过去否定",
          "text": "寒くないです"
        },
        {
          "label": "敬体 · 过去肯定",
          "text": "寒かったです"
        },
        {
          "label": "敬体 · 过去否定",
          "text": "寒くなかったです"
        },
        {
          "label": "简体 · 非过去肯定",
          "text": "寒い"
        },
        {
          "label": "简体 · 非过去否定",
          "text": "寒くない"
        },
        {
          "label": "简体 · 过去肯定",
          "text": "寒かった"
        },
        {
          "label": "简体 · 过去否定",
          "text": "寒くなかった"
        }
      ],
      "addedAt": "2026-11-12",
      "level": "基础"
    },
    {
      "id": "na-adj",
      "group": "四大基本句型",
      "title": "な形容词句",
      "subtitle": "也就是笔记里的「形容动词」",
      "formula": "词干 ＋ です／だ；修饰名词时 ＋ な",
      "description": "な形容词作谓语时，与名词句使用相似的结尾；な主要出现在修饰名词时。",
      "points": [
        "静かだ／静かです：这里很安静；静かな場所：安静的地方。",
        "好き、幸せ、鮮明都是な形容词。",
        "きれい虽然以い结尾，仍然是な形容词。"
      ],
      "examples": [
        {
          "text": "ここは静かです。",
          "kana": "ここはしずかです。",
          "meaning": "这里很安静。",
          "focus": "静かです",
          "source": "笔记例句"
        },
        {
          "text": "ここは静かではなかった。",
          "kana": "ここはしずかではなかった。",
          "meaning": "这里以前不安静。",
          "focus": "ではなかった",
          "source": "笔记例句"
        }
      ],
      "forms": [
        {
          "label": "敬体 · 非过去肯定",
          "text": "静かです"
        },
        {
          "label": "敬体 · 非过去否定",
          "text": "静かではありません"
        },
        {
          "label": "敬体 · 过去肯定",
          "text": "静かでした"
        },
        {
          "label": "敬体 · 过去否定",
          "text": "静かではありませんでした"
        },
        {
          "label": "简体 · 非过去肯定",
          "text": "静かだ"
        },
        {
          "label": "简体 · 非过去否定",
          "text": "静かではない"
        },
        {
          "label": "简体 · 过去肯定",
          "text": "静かだった"
        },
        {
          "label": "简体 · 过去否定",
          "text": "静かではなかった"
        }
      ],
      "addedAt": "2026-11-12",
      "level": "基础"
