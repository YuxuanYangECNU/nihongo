    {
      "id": "verb",
      "group": "四大基本句型",
      "title": "动词句",
      "subtitle": "食べます与食べる，表达方式的切换",
      "formula": "ます／ません／ました／ませんでした",
      "description": "动词自己承担句尾变化。先认识四种敬体和四种简体，再学习各类动词怎样变形。",
      "points": [
        "食べる可以表示习惯或将来要吃，不等于“正在吃”。",
        "不同类别的动词，ない形、た形的变法不同。",
        "正在做某事通常涉及ている，后续再展开。"
      ],
      "examples": [
        {
          "text": "私はご飯を食べます。",
          "kana": "わたしはごはんをたべます。",
          "meaning": "我吃饭。",
          "focus": "食べます",
          "source": "笔记例句"
        },
        {
          "text": "私はご飯を食べなかった。",
          "kana": "わたしはごはんをたべなかった。",
          "meaning": "我没有吃饭。",
          "focus": "食べなかった",
          "source": "笔记例句"
        }
      ],
      "forms": [
        {
          "label": "敬体 · 非过去肯定",
          "text": "食べます"
        },
        {
          "label": "敬体 · 非过去否定",
          "text": "食べません"
        },
        {
          "label": "敬体 · 过去肯定",
          "text": "食べました"
        },
        {
          "label": "敬体 · 过去否定",
          "text": "食べませんでした"
        },
        {
          "label": "简体 · 非过去肯定",
          "text": "食べる"
        },
        {
          "label": "简体 · 非过去否定",
          "text": "食べない"
        },
        {
          "label": "简体 · 过去肯定",
          "text": "食べた"
        },
        {
          "label": "简体 · 过去否定",
          "text": "食べなかった"
        }
      ],
      "addedAt": "2026-11-12",
      "level": "基础"
    },
    {
      "id": "classes",
      "group": "动词与变形",
      "title": "动词分类",
      "subtitle": "一类・二类・三类",
      "formula": "五段／一段／不规则动词",
      "description": "先排除する、来る；其余动词再根据词尾初步判断。い／え段＋る只是二类的候选条件。",
      "points": [
        "一类：書く、歌う、読む，以及る前为あ／う／お段的动词。",
        "二类：食べる、見る等。る前是い／え段，但有例外，不能一概判断。",
        "三类：する、来る（くる），以及勉強する等复合形式。",
        "特殊一类：帰る、走る、滑る、入る（はいる）、減る、知る、要る、散る。",
        "原笔记的入る（いる）：若意思是“需要”，应写要る。居る（いる，“在”）则是二类。"
      ],
      "examples": [
        {
          "text": "毎日、学校へ行きます。",
          "kana": "まいにち、がっこうへいきます。",
          "meaning": "每天去学校。",
          "focus": "行きます",
          "source": "原创拓展"
        },
        {
          "text": "家で音楽を聴きます。",
          "kana": "いえでおんがくをききます。",
          "meaning": "在家听音乐。",
          "focus": "聴きます",
          "source": "原创拓展"
        }
      ],
      "forms": [],
      "addedAt": "2026-11-12",
      "level": "基础"
    },
    {
      "id": "dictionary",
      "group": "动词与变形",
      "title": "动词原形／辞书形",
      "subtitle": "词典里的基本形式",
      "formula": "食べる・聴く・する・来る",
      "description": "辞书形可以作简体非过去肯定，也可以接后续语法。它不是敬体ます形。",
      "points": [
        "查词时通常使用辞书形：食べます→食べる。",
        "辞书形＋前に、こと等，可以组成你已经学过的句型。",
        "不要只凭ます形判断动词类别，先查到辞书形。"
      ],
      "examples": [
        {
          "text": "私はご飯を食べる。",
          "kana": "わたしはごはんをたべる。",
          "meaning": "我吃饭。",
          "focus": "食べる",
          "source": "笔记例句"
        },
        {
          "text": "寝る前に、音楽を聴きます。",
          "kana": "ねるまえに、おんがくをききます。",
          "meaning": "睡觉前听音乐。",
          "focus": "寝る",
          "source": "笔记例句"
        }
      ],
      "forms": [],
      "addedAt": "2026-11-12",
      "level": "基础"
    },
    {
      "id": "before",
      "group": "动词原形相关句型",
      "title": "～前に",
      "subtitle": "在……之前",
      "formula": "动词辞书形 ＋ 前に",
      "description": "先做后半句的动作，再做前に前面的动作。",
      "points": [
        "食べる前に手を洗う：先洗手，再吃饭。",
        "即使主句是过去时，前に前仍然用辞书形。",
        "名词也可接の前に，但本条先掌握动词接续。"
      ],
      "examples": [
        {
          "text": "ご飯を食べる前に、手を洗ってください。",
          "kana": "ごはんをたべるまえに、てをあらってください。",
          "meaning": "吃饭前，请洗手。",
          "focus": "食べる前に",
          "source": "笔记例句"
        },
        {
          "text": "寝る前に、音楽を聴きます。",
          "kana": "ねるまえに、おんがくをききます。",
          "meaning": "睡觉前听音乐。",
          "focus": "寝る前に",
          "source": "笔记例句"
        }
      ],
      "forms": [],
      "addedAt": "2026-11-12",
      "level": "基础"
    },
    {
